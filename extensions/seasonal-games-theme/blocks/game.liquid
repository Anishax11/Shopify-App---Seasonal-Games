<div class="seasonal-game">
    <h2> Spin & Win!</h2>
    <p>Spin the wheel to reveal your reward.</p>
  
    <div class="wheel-container">
      <div class="pointer">▼</div>
  
      <div class="wheel">
        
      </div>
    </div>
  
    <button type="button" class="spin-button">
      SPIN
    </button>
  </div>
  
  <style>
    .seasonal-game {
      text-align: center;
      padding: 30px;
    }
  
    .wheel-container {
      position: relative;
      width: 300px;
      height: 300px;
      margin: 30px auto;
    }
  
    
    .wheel {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      border: 5px solid #222;
      background: conic-gradient(
        from 0deg,
        var(--wheel-gradient)
      );
      position: relative;
      transition: transform 4s ease-out;
    }
  
    .wheel-label {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 68px;
      text-align: center;
      transform-origin: 0 0;
      font-weight: bold;
      font-size: 13px;
      line-height: 1.2;
      overflow-wrap: break-word;
      word-break: normal;
    }
    .pointer {
      position: absolute;
      z-index: 2;
      top: -15px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 30px;
    }
  
    .spin-button {
      padding: 12px 30px;
      font-size: 16px;
      cursor: pointer;
    }

    .wheel {
        transition: transform 4s ease-out;
      }

      
    /* Default styling */
    .seasonal-game {
      color: #222;
      background: #fff;
      border-radius: 16px;
    }

    .seasonal-game h2 {
      margin-bottom: 10px;
    }

    .spin-button {
      border: none;
      border-radius: 8px;
      font-weight: bold;
      transition: background-color 0.2s ease;
    }

    /* Halloween */
    .seasonal-game[data-theme="halloween"] {
      color: #fff;
      background: #21152b;
    }

    .seasonal-game[data-theme="halloween"] .spin-button {
      color: #fff;
      background: #ff7518;
    }

    /* Christmas */
    .seasonal-game[data-theme="christmas"] {
      color: #fff;
      background: #153b2a;
    }

    .seasonal-game[data-theme="christmas"] .spin-button {
      color: #fff;
      background: #c62828;
    }

    /* Diwali */
    .seasonal-game[data-theme="diwali"] {
      color: #4a1535;
      background: #fff0d1;
    }

    .seasonal-game[data-theme="diwali"] .spin-button {
      color: #fff;
      background: #d81b60;
    }

    .spin-button:hover {
      filter: brightness(0.9);
    }

  </style>

  <script>
    const wheel = document.querySelector(".wheel");
    const spinButton = document.querySelector(".spin-button");
    let rewards = [];
    const themePalettes = {
      halloween: [
        "#ff7518", "#6a0dad", "#222222",
        "#ffb347", "#9932cc"
      ],
      christmas: [
        "#c62828", "#2e7d32", "#f9a825",
        "#ffffff", "#8e0000"
      ],
      diwali: [
        "#ff6f00", "#d81b60", "#ffc107",
        "#6a1b9a", "#f4511e"
      ]
    };

    function applyTheme(theme) {
      const selectedTheme = themePalettes[theme?.toLowerCase()]
        ? theme.toLowerCase()
        : "halloween";
    
      colors = themePalettes[selectedTheme];
    
      document.querySelector(".seasonal-game")
        .dataset.theme = selectedTheme;
    }
    
    let colors = themePalettes.halloween; //default
    let spinning = false;
    
    
    async function loadCampaign() {
      try {
        const response = await fetch("/apps/seasonal-games");    
        if (!response.ok) {
          throw new Error(`Request failed: ${response.status}`);
        }
    
        const data = await response.json();
        console.log("Fetched data : ",data);
    
        if (!data.campaign || !data.campaign.rewards.length) {
          wheel.textContent = "No active campaign";
          spinButton.disabled = true;
          return;
        }
        applyTheme(data.campaign.theme);
    
        rewards = data.campaign.rewards;
        buildWheel();
      } catch (error) {
        console.error("Could not load campaign:", error);
        wheel.textContent = "Could not load game";
        spinButton.disabled = true;
      }
    }
    
    function buildWheel() {
      const sliceAngle = 360 / rewards.length;
    
      // Create one colored slice for each reward.
      const gradientStops = rewards.map((reward, index) => {
        const start = index * sliceAngle;
        const end = (index + 1)*sliceAngle;
        const color = colors[index % colors.length];
    
        return `${color} ${start}deg ${end}deg`;
      });
    
      wheel.style.setProperty(
        "--wheel-gradient",
        gradientStops.join(", ")
      );
    
      // Create one label for each reward.
      wheel.replaceChildren();
    
      rewards.forEach((reward, index) => {
      const label = document.createElement("div");
      label.className = "wheel-label";
      label.textContent = reward;
      const start = 270 + index * sliceAngle;
      const angle = start + sliceAngle/2;
      console.log("reward ",reward);
      console.log("angle ",angle);
    
      const radius = Math.min(55, 150 * Math.sin(Math.PI / rewards.length) * 0.65);

      label.style.transform =
        `rotate(${angle}deg) translateX(${radius}px) translateY(-50%)`;
    
      wheel.appendChild(label);
      });
    }
    
    spinButton.addEventListener("click", () => {
      
      if (spinning) return;
      spinning = true;
      const randomIndex = Math.floor(Math.random() * rewards.length);
      const sliceAngle = ( 360 / rewards.length );
      const extraSpins = 4;
      const targetAngle = (rewards.length - randomIndex - 1)*sliceAngle + (sliceAngle/2);
      currentRotation = extraSpins * 360 + targetAngle ;  
      console.log("rotate by : ",currentRotation)
      wheel.style.transition = "transform 4s ease-out";
      wheel.style.transform = `rotate(${currentRotation}deg)`;
  
      setTimeout(() => {
          alert(`🎉 You won: ${rewards[randomIndex]}`);
          spinning = false;
          wheel.style.transition = "none";
          wheel.style.transform = "rotate(0deg)";
      }, 4000);

      

  });
  loadCampaign();

  </script>
  
  {% schema %}
  {
    "name": "Seasonal Game",
    "target": "section",
    "settings": []
  }
  {% endschema %}