<div class="seasonal-game">
    <h2> Spin & Win!</h2>
    <p>Spin the wheel to reveal your reward.</p>
  
    <div class="wheel-container">
      <div class="pointer">▼</div>
  
      <div class="wheel">
        <div class="wheel-label">10% OFF</div>
        <div class="wheel-label">15% OFF</div>
        <div class="wheel-label">20% OFF</div>
        <div class="wheel-label">FREE SHIPPING</div>
        <div class="wheel-label">TRY AGAIN</div>
      </div>
    </div>
  
    <button type="button" class="spin-button">
      SPIN
    </button>
  </div>
  
  <style>
    .seasonal-game {
      text-align: center;
      padding: 30px;
    }
  
    .wheel-container {
      position: relative;
      width: 300px;
      height: 300px;
      margin: 30px auto;
    }
  
    .wheel {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      border: 5px solid #222;
      background: conic-gradient(
        #ff6b6b 0deg 72deg,
        #ffd93d 72deg 144deg,
        #6bcB77 144deg 216deg,
        #4d96ff 216deg 288deg,
        #c77dff 288deg 360deg
      );
      position: relative;
    }

  
    .wheel-label {
        position: absolute;
        left: 50%;
        top: 50%;
        transform-origin: 0 0;
        font-weight: bold;
        font-size: 14px;
      }
      
      .wheel-label:nth-child(1) {
        transform: rotate(15deg) translateX(58px);
      }
      
      .wheel-label:nth-child(2) {
        transform: rotate(88deg) translateX(50px);
      }
      
      .wheel-label:nth-child(3) {
        transform: rotate(155deg) translateX(70px);
      }
      
      .wheel-label:nth-child(4) {
        transform: rotate(229deg) translateX(30px);
      }
      
      .wheel-label:nth-child(5) {
        transform: rotate(300deg) translateX(50px);
      }

    .pointer {
      position: absolute;
      z-index: 2;
      top: -15px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 30px;
    }
  
    .spin-button {
      padding: 12px 30px;
      font-size: 16px;
      cursor: pointer;
    }

    .wheel {
        transition: transform 4s ease-out;
      }
  </style>

  <script>
    const wheel = document.querySelector(".wheel");
    const spinButton = document.querySelector(".spin-button");
  
    const rewards = [
      "10% OFF",
      "15% OFF",
      "20% OFF",
      "FREE SHIPPING",
      "TRY AGAIN"
    ];
    let currentRotation = 0;
    let spinning = false;
  
    spinButton.addEventListener("click", () => {
        if (spinning) return;
        spinning = true;

        const randomIndex = 1//Math.floor(Math.random() * rewards.length);
    
        const sliceAngle = ( 360 / rewards.length );
        const extraSpins = 4;
    
        const targetAngle =
            extraSpins * 360 +
            (360 - randomIndex * sliceAngle - sliceAngle / 2);
            
        currentRotation += extraSpins * 360 + targetAngle - 45;

    
        wheel.style.transform = `rotate(${currentRotation}deg)`;
    
        setTimeout(() => {
            alert(`🎉 You won: ${rewards[randomIndex]}`);
            spinning = false;
        }, 4000);
    });
  </script>
  
  {% schema %}
  {
    "name": "Seasonal Game",
    "target": "section",
    "settings": []
  }
  {% endschema %}